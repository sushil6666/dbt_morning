#!/bin/sh
# Pre-commit hook to run dbt tests before commits

set -e

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

echo "${YELLOW}Running pre-commit dbt tests...${NC}"

if ! command -v dbt &> /dev/null; then
    echo "${RED}❌ dbt is not installed. Install it with: pip install -r requirements.txt${NC}"
    exit 1
fi

CHANGED_FILES=$(git diff --cached --name-only)
DBT_FILES=$(echo "$CHANGED_FILES" | grep -E '\.(sql|yml|yaml|csv)$' || true)

if [ -z "$DBT_FILES" ]; then
    echo "${GREEN}✅ No dbt files changed, skipping tests${NC}"
    exit 0
fi

echo "Changed dbt files detected:"
echo "$DBT_FILES" | sed 's/^/  - /'

echo ""
echo "${YELLOW}Running dbt test...${NC}"

if dbt test --select state:modified+ 2>&1 | tee /tmp/dbt-test.log; then
    echo ""
    echo "${GREEN}✅ All tests passed! Proceeding with commit${NC}"
    exit 0
else
    echo ""
    echo "${RED}❌ dbt tests failed!${NC}"
    echo ""
    echo "Test output:"
    cat /tmp/dbt-test.log
    echo ""
    echo "To bypass this check (not recommended): git commit --no-verify"
    echo "To run tests manually: dbt test"
    exit 1
fi
