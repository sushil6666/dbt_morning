    END,
    CASE UNIFORM(1, 4, RANDOM())
        WHEN 1 THEN 'premium'    WHEN 2 THEN 'regular'
        WHEN 3 THEN 'occasional' ELSE 'new'
    END,
    (RANDOM() < 0.88)::BOOLEAN,
    (RANDOM() < 0.25)::BOOLEAN,
    DATEADD(SECOND, UNIFORM(0, 157680000, RANDOM()), '2015-01-01'::TIMESTAMP_NTZ),
    DATEADD(SECOND, UNIFORM(0, 31536000,  RANDOM()), '2024-01-01'::TIMESTAMP_NTZ),
    DATEADD(SECOND, UNIFORM(0, 126144000, RANDOM()), '2020-01-01'::TIMESTAMP_NTZ),
    CURRENT_TIMESTAMP()
FROM TABLE(GENERATOR(ROWCOUNT => 10000));

-- -------------------------------------------------------
-- CUSTOMER ADDRESSES - 15,000 rows (ADDR000000001 - ADDR000015000)
-- ~1.5 addresses per customer on average
-- -------------------------------------------------------
INSERT INTO RAW.ZOMATO_CUSTOMERS.CUSTOMER_ADDRESSES
SELECT
    'ADDR' || LPAD((SEQ4() + 1)::VARCHAR, 12, '0'),
    'C' || LPAD((UNIFORM(1, 10000, RANDOM()))::VARCHAR, 10, '0'),
    'House ' || UNIFORM(1, 999, RANDOM()) || ', Block ' ||
        CHR(UNIFORM(65, 90, RANDOM())) || ', Locality ' ||
        LPAD((UNIFORM(1, 1000, RANDOM()))::VARCHAR, 4, '0'),
    'AREA' || LPAD((UNIFORM(1, 5000, RANDOM()))::VARCHAR, 6, '0'),
    (RANDOM() < 0.60)::BOOLEAN,
    CURRENT_TIMESTAMP()
FROM TABLE(GENERATOR(ROWCOUNT => 15000));

-- -------------------------------------------------------
-- DELIVERY PARTNERS - 5,000 rows (DP000000001 - DP000005000)
-- -------------------------------------------------------
INSERT INTO RAW.ZOMATO_DELIVERY.DELIVERY_PARTNERS
SELECT
    'DP' || LPAD((SEQ4() + 1)::VARCHAR, 9, '0'),
    'Partner_' || LPAD((SEQ4() + 1)::VARCHAR, 9, '0'),
    '+91' || LPAD((UNIFORM(7000000000, 9999999999, RANDOM()))::VARCHAR, 10, '0'),
    CASE UNIFORM(1, 4, RANDOM())
        WHEN 1 THEN 'bicycle' WHEN 2 THEN 'motorcycle'
        WHEN 3 THEN 'scooter' ELSE 'car'
    END,
    LPAD((UNIFORM(1, 20, RANDOM()))::VARCHAR, 2, '0'),
    (RANDOM() < 0.90)::BOOLEAN,
    (RANDOM() < 0.85)::BOOLEAN,
    UNIFORM(0, 10000, RANDOM()),
    ROUND(NORMAL(4.1, 0.5, RANDOM()), 2),
    ROUND(UNIFORM(0.60, 0.98, RANDOM()), 3),
    DATEADD(SECOND, UNIFORM(0, 157680000, RANDOM()), '2015-01-01'::TIMESTAMP_NTZ),
    DATEADD(SECOND, UNIFORM(0, 126144000, RANDOM()), '2020-01-01'::TIMESTAMP_NTZ),
    CURRENT_TIMESTAMP()
FROM TABLE(GENERATOR(ROWCOUNT => 5000));

-- -------------------------------------------------------
-- ORDERS - 50,000 rows (ORD0000000000001 - ORD0000000050000)
-- Status distribution: delivered 72%, cancelled 10%, refunded 5%,
--                      out_for_delivery 8%, preparing 3%, accepted 2%
-- -------------------------------------------------------
INSERT INTO RAW.ZOMATO_TRANSACTIONAL.ORDERS
WITH base AS (
    SELECT
        SEQ4() + 1                              AS row_num,
        RANDOM()                                AS r1,
        UNIFORM(1, 10000, RANDOM())             AS cust_num,
        UNIFORM(1, 5000,  RANDOM())             AS rest_num,
        UNIFORM(1, 5000,  RANDOM())             AS dp_num,
        UNIFORM(1, 20,    RANDOM())             AS city_num,
        UNIFORM(0, 126144000, RANDOM())         AS sec_offset,
        UNIFORM(50, 2000, RANDOM())             AS subtotal_raw,
        UNIFORM(0, 100,   RANDOM())             AS promo_roll
    FROM TABLE(GENERATOR(ROWCOUNT => 50000))
)
SELECT
    'ORD' || LPAD(row_num::VARCHAR, 13, '0'),
    'C'   || LPAD(cust_num::VARCHAR, 10, '0'),
    'RST' || LPAD(rest_num::VARCHAR, 8, '0'),
    CASE WHEN r1 < 0.82 THEN NULL
         ELSE 'DP' || LPAD(dp_num::VARCHAR, 9, '0') END,
    LPAD(city_num::VARCHAR, 2, '0'),
    CASE WHEN promo_roll < 20
         THEN 'PRO' || LPAD((UNIFORM(1, 5000, RANDOM()))::VARCHAR, 8, '0')
         ELSE NULL END,
    subtotal_raw::NUMBER(12,2),
    CASE WHEN subtotal_raw < 150 THEN 40
         WHEN subtotal_raw < 500 THEN 30
         ELSE 0
    END::NUMBER(8,2),
    5::NUMBER(8,2),
    CASE WHEN promo_roll < 20
         THEN ROUND(subtotal_raw * UNIFORM(0.05, 0.30, RANDOM()), 2)
         ELSE 0
    END::NUMBER(10,2),
    ROUND(subtotal_raw * 0.05, 2)::NUMBER(10,2),
    (subtotal_raw
     + CASE WHEN subtotal_raw < 150 THEN 40 WHEN subtotal_raw < 500 THEN 30 ELSE 0 END
     + 5
     - CASE WHEN promo_roll < 20 THEN ROUND(subtotal_raw * UNIFORM(0.05, 0.30, RANDOM()), 2) ELSE 0 END
     + ROUND(subtotal_raw * 0.05, 2))::NUMBER(12,2),
    CASE WHEN r1 < 0.72 THEN 'delivered'
         WHEN r1 < 0.82 THEN 'cancelled'
         WHEN r1 < 0.87 THEN 'refunded'
         WHEN r1 < 0.95 THEN 'out_for_delivery'
         WHEN r1 < 0.98 THEN 'preparing'
         ELSE 'accepted'
    END,
    CASE WHEN r1 BETWEEN 0.72 AND 0.82
         THEN CASE UNIFORM(1, 5, RANDOM())
                  WHEN 1 THEN 'customer_cancelled'
                  WHEN 2 THEN 'restaurant_rejected'
                  WHEN 3 THEN 'no_delivery_partner'
                  WHEN 4 THEN 'payment_failed'
                  ELSE 'other'
              END
         ELSE NULL END,
    (RANDOM() < 0.30)::BOOLEAN,
    DATEADD(SECOND, sec_offset, '2020-01-01'::TIMESTAMP_NTZ),
    CASE WHEN r1 < 0.82 THEN NULL
         ELSE DATEADD(SECOND, UNIFORM(60, 300, RANDOM()),
                      DATEADD(SECOND, sec_offset, '2020-01-01'::TIMESTAMP_NTZ)) END,
    CASE WHEN r1 < 0.82 THEN NULL
         ELSE DATEADD(SECOND, UNIFORM(900, 2700, RANDOM()),
                      DATEADD(SECOND, sec_offset, '2020-01-01'::TIMESTAMP_NTZ)) END,
    CASE WHEN r1 < 0.72 OR (r1 >= 0.82 AND r1 < 0.87)
         THEN DATEADD(SECOND, UNIFORM(2100, 3600, RANDOM()),
                      DATEADD(SECOND, sec_offset, '2020-01-01'::TIMESTAMP_NTZ))
         ELSE NULL END,
    CASE WHEN r1 < 0.72 OR (r1 >= 0.82 AND r1 < 0.87)
         THEN DATEADD(SECOND, UNIFORM(2700, 5400, RANDOM()),
                      DATEADD(SECOND, sec_offset, '2020-01-01'::TIMESTAMP_NTZ))
         ELSE NULL END,
    CASE WHEN r1 >= 0.72 AND r1 < 0.82
         THEN DATEADD(SECOND, UNIFORM(60, 1800, RANDOM()),
                      DATEADD(SECOND, sec_offset, '2020-01-01'::TIMESTAMP_NTZ))
         ELSE NULL END,
    DATEADD(SECOND, UNIFORM(2700, 86400, RANDOM()),
            DATEADD(SECOND, sec_offset, '2020-01-01'::TIMESTAMP_NTZ)),
    CURRENT_TIMESTAMP()
FROM base;

-- -------------------------------------------------------
-- ORDER ITEMS - ~150,000 rows (3 items per order via CROSS JOIN)
-- FK-consistent: order_id and restaurant_id pulled from ORDERS
-- -------------------------------------------------------
INSERT INTO RAW.ZOMATO_TRANSACTIONAL.ORDER_ITEMS
SELECT
    'OI' || LPAD((ROW_NUMBER() OVER (ORDER BY o.order_id, g.item_num))::VARCHAR, 13, '0'),
    o.order_id,
    'MI' || LPAD((UNIFORM(1, 25000, RANDOM()))::VARCHAR, 10, '0'),
    o.restaurant_id,
    'Item_' || LPAD((UNIFORM(1, 25000, RANDOM()))::VARCHAR, 10, '0'),
    CASE UNIFORM(1, 10, RANDOM())
        WHEN 1 THEN 'Starter'     WHEN 2 THEN 'Main Course'
        WHEN 3 THEN 'Dessert'     WHEN 4 THEN 'Beverage'
        WHEN 5 THEN 'Snack'       WHEN 6 THEN 'Bread'
        WHEN 7 THEN 'Rice'        WHEN 8 THEN 'Combo'
        WHEN 9 THEN 'Salad'       ELSE 'Soup'
    END,
    (RANDOM() < 0.45)::BOOLEAN,
    UNIFORM(1, 5, RANDOM()),
    (UNIFORM(50, 800, RANDOM()))::NUMBER(10,2),
    CASE WHEN RANDOM() < 0.20
         THEN (UNIFORM(10, 100, RANDOM()))::NUMBER(8,2)
         ELSE 0
    END::NUMBER(8,2),
    CURRENT_TIMESTAMP(),
    CURRENT_TIMESTAMP()
FROM RAW.ZOMATO_TRANSACTIONAL.ORDERS o
CROSS JOIN (SELECT SEQ4() + 1 AS item_num FROM TABLE(GENERATOR(ROWCOUNT => 3))) g;

-- -------------------------------------------------------
-- DELIVERIES - ~42,500 rows
-- Only delivered, out_for_delivery, refunded orders get deliveries
-- -------------------------------------------------------
INSERT INTO RAW.ZOMATO_DELIVERY.DELIVERIES
SELECT
    'DLV' || LPAD((ROW_NUMBER() OVER (ORDER BY o.order_id))::VARCHAR, 13, '0'),
    o.order_id,
    COALESCE(o.delivery_partner_id,
             'DP' || LPAD((UNIFORM(1, 5000, RANDOM()))::VARCHAR, 9, '0')),
    CASE WHEN o.order_status = 'delivered'        THEN 'delivered'
         WHEN o.order_status = 'out_for_delivery' THEN 'out_for_delivery'
         ELSE 'delivered'
    END,
    CASE WHEN RANDOM() < 0.03
         THEN CASE UNIFORM(1, 3, RANDOM())
                  WHEN 1 THEN 'partner_unavailable'
                  WHEN 2 THEN 'address_not_found'
                  ELSE 'customer_unavailable'
              END
         ELSE NULL END,
    DATEADD(SECOND, UNIFORM(30, 180, RANDOM()), o.ordered_at),
    DATEADD(SECOND, UNIFORM(180, 480, RANDOM()), o.ordered_at),
    DATEADD(SECOND, UNIFORM(600, 1800, RANDOM()), o.ordered_at),
    COALESCE(o.picked_up_at,
             DATEADD(SECOND, UNIFORM(1200, 2400, RANDOM()), o.ordered_at)),
    COALESCE(o.delivered_at,
             DATEADD(SECOND, UNIFORM(2400, 4800, RANDOM()), o.ordered_at)),
    ROUND(UNIFORM(1.0, 25.0, RANDOM()), 2),
    ROUND(UNIFORM(1.5, 35.0, RANDOM()), 2),
    DATEADD(SECOND, UNIFORM(3000, 90000, RANDOM()), o.ordered_at),
    CURRENT_TIMESTAMP()
FROM RAW.ZOMATO_TRANSACTIONAL.ORDERS o
WHERE o.order_status IN ('delivered', 'out_for_delivery', 'refunded');

-- -------------------------------------------------------
-- PAYMENTS - 50,000 rows (one payment per order)
-- -------------------------------------------------------
INSERT INTO RAW.ZOMATO_PAYMENTS.PAYMENTS
SELECT
    'PAY' || LPAD((ROW_NUMBER() OVER (ORDER BY o.order_id))::VARCHAR, 13, '0'),
    o.order_id,
    CASE WHEN o.order_status = 'cancelled' AND RANDOM() < 0.30   THEN 'failed'
         WHEN o.order_status IN ('delivered','refunded') AND RANDOM() < 0.02 THEN 'refunded'
         ELSE 'success'
    END,
    CASE UNIFORM(1, 10, RANDOM())
        WHEN 1 THEN 'upi'              WHEN 2 THEN 'upi'
        WHEN 3 THEN 'credit_card'      WHEN 4 THEN 'debit_card'
        WHEN 5 THEN 'net_banking'      WHEN 6 THEN 'wallet'
        WHEN 7 THEN 'cash_on_delivery' WHEN 8 THEN 'phonepe'
        WHEN 9 THEN 'amazon_pay'       ELSE 'pay_later'
    END,
    o.total_amount,
    ROUND(o.total_amount * UNIFORM(0.005, 0.025, RANDOM()), 2),
    DATEADD(SECOND, UNIFORM(0, 300, RANDOM()), o.ordered_at),
    DATEADD(DAY,    UNIFORM(1, 3, RANDOM()), o.ordered_at::DATE),
    CURRENT_TIMESTAMP()
FROM RAW.ZOMATO_TRANSACTIONAL.ORDERS o;

-- -------------------------------------------------------
-- RATINGS - ~25,200 rows (70% of delivered orders)
-- ~36,000 delivered * 0.70 = ~25,200
-- -------------------------------------------------------
INSERT INTO RAW.ZOMATO_ENGAGEMENT.RATINGS
SELECT
    'RTG' || LPAD((ROW_NUMBER() OVER (ORDER BY o.order_id))::VARCHAR, 13, '0'),
    o.order_id,
    o.customer_id,
    o.restaurant_id,
    o.delivery_partner_id,
    UNIFORM(1, 5, RANDOM()),
    UNIFORM(1, 5, RANDOM()),
    ROUND((UNIFORM(1, 5, RANDOM()) + UNIFORM(1, 5, RANDOM())) / 2.0, 1),
    DATEADD(SECOND, UNIFORM(1800, 172800, RANDOM()), o.delivered_at),
    CURRENT_TIMESTAMP()
FROM RAW.ZOMATO_TRANSACTIONAL.ORDERS o
WHERE o.order_status = 'delivered'
  AND RANDOM() < 0.70;

-- -------------------------------------------------------
-- REVIEWS - ~12,500 rows (50% of ratings leave a text review)
-- -------------------------------------------------------
INSERT INTO RAW.ZOMATO_ENGAGEMENT.REVIEWS
SELECT
    'RVW' || LPAD((ROW_NUMBER() OVER (ORDER BY r.rating_id))::VARCHAR, 13, '0'),
    r.rating_id,
    CASE UNIFORM(1, 5, RANDOM())
        WHEN 1 THEN 'Great food and super fast delivery!'
        WHEN 2 THEN 'Decent experience, could be better.'
        WHEN 3 THEN 'Food arrived cold. Very disappointed.'
        WHEN 4 THEN 'Loved it! Will definitely order again.'
        ELSE 'Average meal, nothing special.'
    END,
    CASE WHEN r.overall_rating >= 4.0 THEN 'positive'
         WHEN r.overall_rating >= 3.0 THEN 'neutral'
         ELSE 'negative'
    END,
    DATEADD(SECOND, UNIFORM(0, 86400, RANDOM()), r.rated_at),
    CURRENT_TIMESTAMP()
FROM RAW.ZOMATO_ENGAGEMENT.RATINGS r
WHERE RANDOM() < 0.50;

-- -------------------------------------------------------
-- PROMO REDEMPTIONS - ~10,000 rows (all orders that used a promo)
-- 20% of 50,000 orders have promo_id set = ~10,000
-- -------------------------------------------------------
INSERT INTO RAW.ZOMATO_PROMOTIONS.PROMO_REDEMPTIONS
SELECT
    'RDM' || LPAD((ROW_NUMBER() OVER (ORDER BY o.order_id))::VARCHAR, 13, '0'),
    o.order_id,
    o.promo_id,
    o.customer_id,
    o.promo_discount_amount,
    CASE WHEN o.order_status = 'cancelled' AND RANDOM() < 0.15
         THEN 'failed'
         ELSE 'success'
    END,
    CASE WHEN o.order_status = 'cancelled' AND RANDOM() < 0.15
         THEN 'promo_expired'
         ELSE NULL
    END,
    o.ordered_at,
    CURRENT_TIMESTAMP()
FROM RAW.ZOMATO_TRANSACTIONAL.ORDERS o
WHERE o.promo_id IS NOT NULL;

-- -------------------------------------------------------
-- SUPPORT TICKETS - ~5,000 rows (~10% of orders)
-- -------------------------------------------------------
INSERT INTO RAW.ZOMATO_SUPPORT.SUPPORT_TICKETS
SELECT
    'TKT' || LPAD((ROW_NUMBER() OVER (ORDER BY o.order_id))::VARCHAR, 12, '0'),
    o.customer_id,
    o.order_id,
    'AGT' || LPAD((UNIFORM(1, 500, RANDOM()))::VARCHAR, 6, '0'),
    CASE UNIFORM(1, 9, RANDOM())
        WHEN 1 THEN 'missing_item'          WHEN 2 THEN 'wrong_item'
        WHEN 3 THEN 'late_delivery'         WHEN 4 THEN 'damaged_food'
        WHEN 5 THEN 'payment_issue'         WHEN 6 THEN 'refund_request'
        WHEN 7 THEN 'account_issue'         WHEN 8 THEN 'restaurant_complaint'
        ELSE 'other'
    END,
    CASE UNIFORM(1, 4, RANDOM())
        WHEN 1 THEN 'open'        WHEN 2 THEN 'in_progress'
        WHEN 3 THEN 'resolved'    ELSE 'closed'
    END,
    CASE UNIFORM(1, 3, RANDOM()) WHEN 1 THEN 'high' WHEN 2 THEN 'medium' ELSE 'low' END,
    CASE WHEN RANDOM() < 0.80
         THEN CASE UNIFORM(1, 4, RANDOM())
                  WHEN 1 THEN 'full_refund'        WHEN 2 THEN 'partial_refund'
                  WHEN 3 THEN 'replacement_sent'   ELSE 'no_action'
              END
         ELSE NULL END,
    CASE WHEN RANDOM() < 0.75 THEN UNIFORM(1, 5, RANDOM()) ELSE NULL END,
    o.ordered_at,
    DATEADD(SECOND, UNIFORM(300, 7200, RANDOM()), o.ordered_at),
    CASE WHEN RANDOM() < 0.80
         THEN DATEADD(SECOND, UNIFORM(3600, 172800, RANDOM()), o.ordered_at)
         ELSE NULL END,
    DATEADD(SECOND, UNIFORM(3600, 259200, RANDOM()), o.ordered_at),
    CURRENT_TIMESTAMP()
FROM RAW.ZOMATO_TRANSACTIONAL.ORDERS o
WHERE RANDOM() < 0.10;

-- -------------------------------------------------------
-- TICKET COMMENTS - ~10,000 rows (2 comments per ticket)
-- comment 1 from customer, comment 2 from agent
-- -------------------------------------------------------
INSERT INTO RAW.ZOMATO_SUPPORT.TICKET_COMMENTS
SELECT
    'CMT' || LPAD((ROW_NUMBER() OVER (ORDER BY t.ticket_id, g.cmt_num))::VARCHAR, 13, '0'),
    t.ticket_id,
    CASE g.cmt_num WHEN 1 THEN 'customer' ELSE 'agent' END,
    CASE UNIFORM(1, 6, RANDOM())
        WHEN 1 THEN 'I have an issue with my recent order.'
        WHEN 2 THEN 'We are looking into this and will get back to you shortly.'
        WHEN 3 THEN 'Could you please provide your order details?'
        WHEN 4 THEN 'The issue has been escalated to our team.'
        WHEN 5 THEN 'Thank you for reaching out. We apologize for the inconvenience.'
        ELSE 'Your request has been processed. Please allow 24 hours.'
    END,
    DATEADD(SECOND, g.cmt_num * UNIFORM(1800, 7200, RANDOM()), t.created_at),
    CURRENT_TIMESTAMP()
FROM RAW.ZOMATO_SUPPORT.SUPPORT_TICKETS t
CROSS JOIN (SELECT SEQ4() + 1 AS cmt_num FROM TABLE(GENERATOR(ROWCOUNT => 2))) g;
