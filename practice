-- ============================================================
-- Dev Quick-Load: >= 5,000 rows per table
-- Runs in ~3-5 minutes on an XS warehouse.
-- Truncates all tables first, then inserts in FK dependency order.
--
-- Usage:  python orchestrate.py --step dev
--
-- Row count targets:
--   CITIES              :    20  (reference - bounded to real Indian cities)
--   PAYMENT_METHODS     :    10  (static reference)
--   AREAS               :  5,000
--   PROMOTIONS          :  5,000
--   RESTAURANTS         :  5,000
--   MENU_ITEMS          : 25,000
--   CUSTOMERS           : 10,000
--   CUSTOMER_ADDRESSES  : 15,000
--   DELIVERY_PARTNERS   :  5,000
--   ORDERS              : 50,000
--   ORDER_ITEMS         :~150,000  (3 per order)
--   DELIVERIES          : ~42,500  (~85% of orders)
--   PAYMENTS            : 50,000   (one per order)
--   RATINGS             : ~25,000  (70% of delivered orders)
--   REVIEWS             : ~12,500  (50% of ratings)
--   PROMO_REDEMPTIONS   : ~10,000  (orders with promo_id set)
--   SUPPORT_TICKETS     :  ~5,000  (10% of orders)
--   TICKET_COMMENTS     : ~10,000  (2 per ticket)
--
-- city_id uses zero-padded 2-char format ('01'-'20') for FK consistency
-- with all LPAD(UNIFORM(1,20,RANDOM()),2,'0') references in child tables.
-- ============================================================

USE DATABASE RAW;

-- -------------------------------------------------------
-- Truncate in reverse FK dependency order
-- -------------------------------------------------------
TRUNCATE TABLE RAW.ZOMATO_SUPPORT.TICKET_COMMENTS;
TRUNCATE TABLE RAW.ZOMATO_SUPPORT.SUPPORT_TICKETS;
TRUNCATE TABLE RAW.ZOMATO_PROMOTIONS.PROMO_REDEMPTIONS;
TRUNCATE TABLE RAW.ZOMATO_ENGAGEMENT.REVIEWS;
TRUNCATE TABLE RAW.ZOMATO_ENGAGEMENT.RATINGS;
TRUNCATE TABLE RAW.ZOMATO_PAYMENTS.PAYMENTS;
TRUNCATE TABLE RAW.ZOMATO_DELIVERY.DELIVERIES;
TRUNCATE TABLE RAW.ZOMATO_TRANSACTIONAL.ORDER_ITEMS;
TRUNCATE TABLE RAW.ZOMATO_TRANSACTIONAL.ORDERS;
TRUNCATE TABLE RAW.ZOMATO_DELIVERY.DELIVERY_PARTNERS;
TRUNCATE TABLE RAW.ZOMATO_CUSTOMERS.CUSTOMER_ADDRESSES;
TRUNCATE TABLE RAW.ZOMATO_CUSTOMERS.CUSTOMERS;
TRUNCATE TABLE RAW.ZOMATO_RESTAURANTS.MENU_ITEMS;
TRUNCATE TABLE RAW.ZOMATO_RESTAURANTS.RESTAURANTS;
TRUNCATE TABLE RAW.ZOMATO_PROMOTIONS.PROMOTIONS;
